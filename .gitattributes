# Patches and the byte-for-byte AndroidX fork checks must see the same source bytes on each OS.
*.kt text eol=lf
*.kts text eol=lf
*.patch text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.txt text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Android capture manifests hash the exact file bytes, including line endings.
conformance/android/fixtures/matrix/** -text
